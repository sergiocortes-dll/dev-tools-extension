{
  "manifest_version": 3,
  "name": "PR Toolkit",
  "version": "1.1.0",
  "description": "Herramientas para pull requests de Bitbucket. Incluye extracción de comentarios de revisión a Markdown compacto.",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "PR Toolkit"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting", "storage", "webRequest"],
  "host_permissions": ["<all_urls>"]
}
